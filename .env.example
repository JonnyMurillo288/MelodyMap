# ========================================
# PostgreSQL
# ========================================
# Local dev:
PG_DSN=postgres://postgres:YOUR_PASSWORD@localhost:5432/musicbrainz_db?sslmode=disable
# Railway: use ${{Postgres.DATABASE_URL}} (auto-injected)
# Render: auto-injected from linked database
MB_DB_USER=postgres
MB_DB_PASSWORD=YOUR_PASSWORD
MB_DB_HOST=localhost
MB_DB_PORT=5432
MB_DB_NAME=musicbrainz_db
MB_DB_SSLMODE=disable
# Production: set MB_DB_SSLMODE=require

# ========================================
# Application
# ========================================
PORT=8080
# Local dev:
ML_SERVICE_URL=http://ml:8000
# Railway: ML_SERVICE_URL=http://melodymap-ml.railway.internal:8000
# Render: ML_SERVICE_URL=http://melodymap-ml:8000 (internal networking)
RUN_ENV=docker
# Production: RUN_ENV=production (disables --reload in ML service, enables workers)

# ========================================
# Internal Service Auth
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ========================================
INTERNAL_SERVICE_SECRET=GENERATE_A_SECRET_HERE
SDS_TOKEN_SECRET=GENERATE_A_SECRET_HERE

# ========================================
# Spotify OAuth
# ========================================
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
SPOTIFY_TOKEN_PATH=spotify_token.json

# ========================================
# Last.fm API
# ========================================
LASTFM_API_KEY=YOUR_LASTFM_API_KEY
LASTFM_API_SECRET=YOUR_LASTFM_API_SECRET

# ========================================
# ML Model Defaults (optional overrides)
# ========================================
DEFAULT_LOGIT_VERSION=v8
DEFAULT_CVAE_VERSION=v1
